# Supabase — copy to .env and fill in from your Supabase project.
# Dashboard → Settings → API Keys (or the "Connect" button at the top).
#
# VITE_SUPABASE_URL              → Project URL, e.g. https://abcxyz.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY  → the Publishable key (starts with sb_publishable_)
#
# The publishable key replaced the old "anon" key and is safe to expose in a
# client bundle — data access is enforced by Row-Level Security. Do NOT put the
# secret key (sb_secret_...) here; that's backend-only and this app never uses it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
